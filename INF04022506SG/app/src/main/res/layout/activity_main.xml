<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="#5F9EA0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp">

        <!-- LEWA KOLUMNA -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Podaj wartość klucza"
                android:textColor="#FAEBD7"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/editKey"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/white"
                android:padding="6dp"
                android:inputType="number" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Podaj tekst"
                android:textColor="#FAEBD7"
                android:textSize="18sp"
                android:layout_marginTop="20dp" />

            <EditText
                android:id="@+id/editInput"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="8dp"
                android:gravity="top"
                android:padding="10dp"
                android:background="@color/white"
                android:inputType="textMultiLine"
                android:scrollbars="vertical" />

            <Button
                android:id="@+id/buttonHash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Zaszyfruj"
                android:backgroundTint="#ADD8E6" />


        </LinearLayout>

        <!-- PRAWA KOLUMNA -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tekst zaszyfrowany"
                android:textColor="#FAEBD7"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/textEncrypted"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="10dp"
                android:padding="10dp"
                android:textColor="#F0F8FF"
                android:gravity="top"
                android:scrollbars="vertical" />

            <Button
                android:id="@+id/buttonSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Zapisz szyfr w pliku"
                android:backgroundTint="#ADD8E6" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
